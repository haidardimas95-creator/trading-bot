{
  "crons": [
    {
      "path": "/api/scan",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/check-exits",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
